# 复制为 .env 并填入你的配置
# LLM_PROVIDER 可选: mock | deepseek | openai
# 默认 mock：无需 API Key 即可离线运行（评测 + 冒烟 + 服务均可跑）
# 切换真实模型：改 LLM_PROVIDER=deepseek 并填入 LLM_API_KEY

LLM_PROVIDER=mock

# ---- DeepSeek（OpenAI 兼容协议）----
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ---- OpenAI ----
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.2
AGENT_MAX_STEPS_PER_TURN=8
AGENT_CONFIDENCE_FLOOR=0.7
AGENT_MAX_CONTEXT_MESSAGES=12
TOOL_TIMEOUT_SECONDS=15
TRACE_LOG_PATH=logs/trace.jsonl
